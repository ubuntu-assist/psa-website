# Resend — https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Sender. psa.com must be verified in Resend (Domains → Add domain → add the DNS records).
RESEND_FROM="Pépinière Semences d'Avenir <contact@psa.com>"

# Where form submissions are delivered (comma-separated for several addresses)
RESEND_TO=contact@psa.com

# Optional: Resend segment id to file newsletter subscribers in (Audience → Segments)
RESEND_SEGMENT_ID=

# Public site URL, used for the logo and links inside emails (no trailing slash)
SITE_URL=https://www.psa.com

# CMS (/admin) GitHub sign-in — GitHub → Settings → Developer settings → OAuth Apps → New
#   Homepage URL: https://www.psa.com   Callback URL: https://www.psa.com/api/auth/callback
GITHUB_OAUTH_ID=
GITHUB_OAUTH_SECRET=
